# Same values work for Docker infra (bun run infra:up) and native Postgres/Memurai installs.
DATABASE_URL=postgres://drishti:drishti@localhost:5432/drishti
REDIS_URL=redis://localhost:6379
API_PORT=3001
STREAM_PORT=3002
# API + stream listen on localhost only. HOST=0.0.0.0 exposes them to your network (then also set WEB_ORIGINS).
HOST=127.0.0.1
# Browser origins allowed to use the API/stream (comma list). Empty = Vite dev server + Tauri webview.
WEB_ORIGINS=
# Web: leave empty in browser dev (Vite proxy). Tauri sets absolute URLs.
VITE_API_URL=
VITE_STREAM_URL=

# Live feeds. FEED=demo replaces them with a random walk (offline / weekends).
FEED=
# Upstox, either way (both may be set; a fresh in-app login wins over the .env token):
# 1) Token from the Upstox developer dashboard (e.g. the long-lived read-only analytics token). Keep it secret.
UPSTOX_ACCESS_TOKEN=
# 2) In-app daily login: Upstox app (account.upstox.com/developer/apps). Redirect URL must match exactly.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3001/auth/upstox/callback

# SEC EDGAR requires a contact in the User-Agent for the Insider Trades panel (Form 4). Yours, used only for requests to sec.gov.
SEC_EDGAR_CONTACT=
