# Same values work for Docker infra (bun run infra:up) and native Postgres/Memurai installs.
DATABASE_URL=postgres://drishti:drishti@localhost:5432/drishti
REDIS_URL=redis://localhost:6379
API_PORT=3001
STREAM_PORT=3002
# API + stream listen on localhost only. HOST=0.0.0.0 exposes them to your network (then also set WEB_ORIGINS).
HOST=127.0.0.1
# Browser origins allowed to use the API/stream (comma list). Empty = Vite dev server + Tauri webview.
WEB_ORIGINS=
# Web: leave empty in browser dev (Vite proxy). Tauri sets absolute URLs.
VITE_API_URL=
VITE_STREAM_URL=

# Live feeds. FEED=demo replaces them with a random walk (offline / weekends).
FEED=
# Upstox, either way (both may be set; a fresh in-app login wins over the .env token):
# 1) Token from the Upstox developer dashboard (e.g. the long-lived read-only analytics token). Keep it secret.
UPSTOX_ACCESS_TOKEN=
# 2) In-app daily login: Upstox app (account.upstox.com/developer/apps). Redirect URL must match exactly.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3001/auth/upstox/callback

# SEC EDGAR requires a contact in the User-Agent for the Insider Trades panel (Form 4). Yours, used only for requests to sec.gov.
SEC_EDGAR_CONTACT=

# MCX price source preference: upstox | tradingview (default: Upstox, then TradingView). Also switchable in Settings → Data feeds.
MCX_PRIMARY=

# AI briefing panel (optional). Anthropic API key, kept server-side. Without it the panel just says it is off.
ANTHROPIC_API_KEY=
# Model for briefings (default claude-opus-5-5; claude-sonnet-5-5 is cheaper).
BRIEFING_MODEL=

# EIA open data (free key from https://www.eia.gov/opendata/): fills the EIA petroleum panel
EIA_API_KEY=

# Percent gap between two live feeds that flags a price as disputed (default 0.15)
DRIFT_FLAG_PCT=

# Server-side alerts (they fire with the app closed). Telegram: create a bot with @BotFather, put its token here, send the bot any message,
# then press "Link Telegram" in the Alerts panel (or set TELEGRAM_CHAT_ID yourself). ALERT_WEBHOOK_URL is an optional URL that receives a JSON POST.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# MCX on TradingView needs the traded dated contract. Without a known front month the continuous code (1!) would show the wrong contract near expiry, so it is OFF unless you set this to 1.
TV_MCX_CONTINUOUS=

# MCP server for Claude (apps/drishti-mcp): simulated paper trades placed by an agent show up in the Paper panel.
# Writes are OFF unless this is exactly 1. The agent's caps are enforced by the stream service (defaults: 2 lots per order, 4 open positions, 20 orders a day).
MCP_PAPER_WRITE=
MCP_BRIEFING_WRITE=
MCP_PAPER_ACCOUNT=
PAPER_MCP_MAX_LOTS=
PAPER_MCP_MAX_POSITIONS=
PAPER_MCP_MAX_ORDERS_PER_DAY=

# Records option open interest every 10 min while MCX is open, so the detailed chain can show OI change (off = disabled)
# OI_RECORDER=off
