{
  "name": "divya-drishti",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev --filter=!drishti-desktop",
    "desktop": "bun run --cwd apps/drishti-desktop dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "infra:up": "docker compose up -d --wait && bun --env-file=.env scripts/migrate.ts",
    "infra:down": "docker compose down",
    "db:migrate": "bun scripts/migrate.ts",
    "db:clean": "bun scripts/db-clean.ts",
    "fixtures:refresh": "bun --env-file=.env scripts/fixtures.ts",
    "gdelt:backfill": "bun --env-file=.env scripts/gdelt-backfill.ts",
    "cl:history": "bun --env-file=.env scripts/cl-history.ts",
    "eia:archive": "bun --env-file=.env scripts/eia-archive-backfill.ts",
    "gold:sample": "bun --env-file=.env research/sentiment/make-gold-sample.ts",
    "fixtures:upstox-charges": "bun --env-file=.env scripts/upstox-charges-fixture.ts",
    "e2e": "bun e2e/run.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/bun": "^1.4.0",
    "playwright-core": "^1.64.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
